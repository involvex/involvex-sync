{
  "expo": {
    "name": "involvex Sync",
    "slug": "involvex-sync",
    "scheme": "involvex-sync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.involvex.sync"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0b1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.involvex.sync",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "com.involvex.termux_app.permission.RUN_COMMAND"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/*"
            },
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/*"
            },
            {
              "mimeType": "*/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3d7eff"
        }
      ],
      "./modules/invx-share/app.plugin.js",
      "./modules/invx-keepalive/app.plugin.js",
      "./modules/invx-termux/app.plugin.js",
      "./modules/invx-mdns/app.plugin.js",
      "./modules/invx-notify/app.plugin.js",
      "./modules/invx-ime/app.plugin.js",
      "./modules/invx-a11y/app.plugin.js",
      "./modules/invx-clipboard/app.plugin.js",
      "./plugins/withCleartextTraffic.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the PC pairing QR code",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Secrets with Face ID"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "relayUrl": "wss://sync.involvex.workers.dev/ws",
      "termuxPackage": "com.involvex.termux_app"
    }
  }
}
