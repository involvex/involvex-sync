{
  "name": "@involvex/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "bun check && expo:check",
    "expo:check": "expo install --check",
    "prebuild": "expo prebuild --platform android",
    "build": "expo run:android --variant release --no-bundler",
    "build:apk": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@expo/config-plugins": "~58.0.0",
    "@involvex/protocol": "workspace:*",
    "@ungap/structured-clone": "^1.4.0",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-modules-core": "^58.0.29",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
