{
  "name": "@involvex/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "bun check && bun check -p tsconfig.test.json && expo:check",
    "expo:check": "expo install --check",
    "test": "bun test",
    "prebuild": "expo prebuild --platform android",
    "build": "expo run:android --variant release --no-bundler",
    "build:apk": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@involvex/protocol": "workspace:*",
    "@ungap/structured-clone": "^1.4.0",
    "expo": "~58.0.25",
    "expo-auth-session": "~58.0.18",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
